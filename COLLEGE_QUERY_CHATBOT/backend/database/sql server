-- =========================
-- 2. CHATBOT INTENTS TABLE
-- =========================
CREATE TABLE chatbot_intents (
    intent_id INT IDENTITY(1,1) PRIMARY KEY,
    module_id INT NOT NULL,
    language NVARCHAR(20) NOT NULL,
    intent_name NVARCHAR(100) NOT NULL,
    keywords NVARCHAR(MAX) NOT NULL,
    response NVARCHAR(MAX) NOT NULL,
    processing_time NVARCHAR(50) DEFAULT NULL,
    fees DECIMAL(10,2) DEFAULT NULL,
    office_location NVARCHAR(255) DEFAULT NULL,
    FOREIGN KEY (module_id) REFERENCES modules(module_id)
);
